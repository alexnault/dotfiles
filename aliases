# Easier navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

# Shortcuts
alias pro="cd ~/Projects"
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias g="git"
alias dc="docker compose"

# Colored ls (GNU and macOS ls both understand --color)
alias ls="ls --color=auto"
alias l="ls -lF"
alias la="ls -laF"

alias grep="grep --color=auto"

# Expand aliases after sudo (aliases must not start with `command`, which sudo can't run)
alias sudo="sudo "

# Reload the shell
alias reload='exec $SHELL -l'

# Print each PATH entry on a separate line
alias path='print -l $path'
